# Provider: onprem-compose | onprem | aws
HCP_PROVIDER=onprem-compose
HCP_ENV=dev

# AWS (when HCP_PROVIDER=aws — credentials via IAM/env/profile, never in repo)
# AWS_S3_BUCKET=hcp-dev-artifacts
# AWS_REGION=us-east-1

# API
DATABASE_URL=postgresql+psycopg2://hcp:hcp@localhost:5432/hcp
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-in-production
API_HOST=0.0.0.0
API_PORT=8000

# MinIO (on-prem storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=hcp
MINIO_SECRET_KEY=hcpsecret
MINIO_BUCKET=hcp-local
MINIO_REGION=us-east-1
